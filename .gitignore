# ---- colcon / ROS 2 workspace ----
build/
install/
log/
.colcon/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ---- experiment artefacts ----
# Recordings and reports are large and regenerable. Keep the scenario
# definitions, seeds and parameter sets in git; keep the outputs out.
bags/
*.db3
*.mcap
results/
reports/

# ---- model weights ----
# Pull from source at setup time; never vendor. Licences differ per weight
# file (see REFERENCES.md section 3).
*.pt
*.pth
*.onnx
*.engine
weights/

# ---- scratch ----
# Accidental saves and working copies of the deck. The tracked submission
# artefacts are deck/SIH2026_PS26126_Idea_Presentation.pptx and .pdf; anything
# else at the root is scratch.
/*.pptx
/*.pdf
/*.docx

# ---- editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
